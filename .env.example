# Required by scripts/generate-clas-fixtures.js
# PKCS8 Ed25519 private key PEM corresponding to the public key
# registered in the fixture ENS records (cl.sig.pub).
# Generate a keypair with: node --input-type=module <<'EOF'
#   const k = await crypto.subtle.generateKey({name:'Ed25519'},{true,['sign','verify']});
#   const pkcs8 = Buffer.from(await crypto.subtle.exportKey('pkcs8',k.privateKey)).toString('base64');
#   console.log('-----BEGIN PRIVATE KEY-----\n'+pkcs8.match(/.{1,64}/g).join('\n')+'\n-----END PRIVATE KEY-----');
# EOF
CL_PRIVATE_KEY_PEM=

# Optional launch trust root for CommandLayer factory execution receipts.
# VerifyAgent uses this configured HTTPS document before ENS. A reachable
# document with a conflicting/missing key is authoritative and is not bypassed
# through ENS. ENS is only an availability fallback when this URL is disabled
# or unavailable.
COMMANDLAYER_RECEIPT_KEY_URL=https://api.commandlayer.org/.well-known/commandlayer-receipt-keys
